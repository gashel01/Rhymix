# Rhymix — example environment file
# Copy to `.env` and fill in the values you need. All variables are optional:
# sensible defaults are used when a variable is unset.
#
# For the full reference of what each variable does, see docs/CONFIGURATION.md

# ---------------------------------------------------------------------------
# WhisperX — separate venv (set automatically by setup.bat)
# ---------------------------------------------------------------------------
# Rhymix runs WhisperX in an isolated process to avoid dependency conflicts.
# Point this at the root of the WhisperX venv that setup.bat created.
# WHISPERX_VENV=C:\path\to\Rhymix\whisperX
#
# Or point directly at a Python executable if you prefer:
# WHISPERX_PYTHON=C:\path\to\whisperX\Scripts\python.exe

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
RHYMIX_ENABLE_LOGS=0
RHYMIX_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Studio — AI adapter (how Studio routes AI jobs)
# ---------------------------------------------------------------------------
# Adapter: "local" enables the in-process Python bridge. Leave unset for
# NotConfigured (returns a friendly error for AI actions).
STUDIO_AI_ADAPTER=local
STUDIO_AI_BRIDGE=backend.features.studio.ai_bridge_acestep
STUDIO_AI_PYTHON=python
STUDIO_AI_EXTRACT_MODEL=acestep-v15-base
STUDIO_AI_PERSISTENT=0

# ---------------------------------------------------------------------------
# Studio — Voice / Beat → MIDI
# ---------------------------------------------------------------------------
# Frontend WebSocket URL for the voice→MIDI panel
REACT_APP_VOICE_MIDI_WS=ws://localhost:8002/ws/voice_to_midi

# Engine: basic_pitch | crepe | ddsp | aubio | auto
VOICE_MIDI_MELODY_ENGINE=auto

# Pre-processing toggle + audio clean-up
VOICE_MIDI_PREPROCESS=1
VOICE_MIDI_KEEP_WAV=0
VOICE_MIDI_GATE_DB=-45
VOICE_MIDI_GATE_MODE=soft
VOICE_MIDI_LOW_PASS=6000
VOICE_MIDI_HIGH_PASS=80
VOICE_MIDI_TRIM_DB=35
VOICE_MIDI_NORMALIZE=1
VOICE_MIDI_PREPROCESS_SR=22050

# Basic Pitch
VOICE_MIDI_BP_MIN_FREQ=65
VOICE_MIDI_BP_MAX_FREQ=1200

# CREPE
VOICE_MIDI_CREPE_CONF=0.35
VOICE_MIDI_CREPE_FMIN=50
VOICE_MIDI_CREPE_FMAX=800
VOICE_MIDI_CREPE_SR=16000
VOICE_MIDI_CREPE_STABLE_FRAMES=4
VOICE_MIDI_CREPE_HANGOVER=4
VOICE_MIDI_CREPE_MIN_NOTE_MS=0.08

# DDSP (experimental)
DDSP_MODEL_DIR=models/ddsp
VOICE_MIDI_DDSP_CONF=0.3
VOICE_MIDI_DDSP_FMIN=50
VOICE_MIDI_DDSP_FMAX=1200
VOICE_MIDI_DDSP_FRAME_RATE=250
VOICE_MIDI_DDSP_STRICT=0

# Note-shaping (applies to all engines)
VOICE_MIDI_MIN_NOTE_MS=0.09
VOICE_MIDI_NOTE_GAP_SEC=0.06
VOICE_MIDI_MIN_VELOCITY=40

# ---------------------------------------------------------------------------
# Voice → MIDI signal processing (optional EQ + compressor + denoise)
# ---------------------------------------------------------------------------
VOICE_MIDI_PROCESSING=0
VOICE_MIDI_EQ_LOW_DB=0
VOICE_MIDI_EQ_MID_DB=0
VOICE_MIDI_EQ_HIGH_DB=0
VOICE_MIDI_EQ_LOW_FREQ=200
VOICE_MIDI_EQ_HIGH_FREQ=4000
VOICE_MIDI_COMPRESSOR_THRESHOLD=-20
VOICE_MIDI_COMPRESSOR_RATIO=4
VOICE_MIDI_COMPRESSOR_ATTACK_MS=5
VOICE_MIDI_COMPRESSOR_RELEASE_MS=50
VOICE_MIDI_COMPRESSOR_MAKEUP_DB=0
VOICE_MIDI_NOISE_REDUCTION_STRENGTH=0
VOICE_MIDI_PITCH_SHIFT=0

# ---------------------------------------------------------------------------
# RVC / voice conversion
# ---------------------------------------------------------------------------
RHYMIX_WARMUP_ON_STARTUP=0
RVC_MODEL_CACHE_SIZE=2
