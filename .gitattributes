# Ensure Windows batch/cmd files always use CRLF line endings on checkout.
# Without this, edits from Linux/Mac tools convert them to LF, which breaks
# cmd.exe (batch files require CRLF to parse correctly).
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Python and other source files use LF everywhere
*.py    text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
